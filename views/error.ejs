<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= (typeof title !== 'undefined' ? title : 'Error') %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1><%= (typeof title !== 'undefined' ? title : 'Error') %></h1>
    <p><%= (typeof message !== 'undefined' ? message : 'Something went wrong.') %></p>
  </div>
</body>
</html>
